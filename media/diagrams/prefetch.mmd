flowchart LR
    subgraph server [Server]
        direction TB
        s1[Server start] --> s2[Preload display fields of every folder]
        s3[Each sync] --> s4[Fetch display fields of new ids only]
        s5[Message deleted] --> s6[Drop its cached entries]
    end
    subgraph browser [Browser]
        direction TB
        b1[App idle] --> b2[Load every account INBOX]
        b3[Hover a folder] --> b4[Load its first page]
        b5[List loaded] --> b6[Load first 8 unread bodies and next page]
        b7[Open a conversation] --> b8[Load bodies 3 at a time outwards from selected]
    end
